# CookMate Environment Configuration Template
# Copy this file to .env and adjust the values for your local environment

# Flask Application Settings
SECRET_KEY=cookmate-super-secret-key-2026-btech-project
FLASK_APP=app.py
FLASK_DEBUG=True
PORT=5000

# MySQL Database Configuration
# When MySQL is installed, set your credentials below.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=cookmate_db

# AI Chef Assistant Configuration (Optional external AI key)
# Supports Gemini API, OpenAI API, or OpenRouter
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here
